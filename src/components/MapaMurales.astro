---
import type { Artista } from '../domain/murales.ts';
import type { DatosMapa } from '../map/datos-cliente.ts';
import PanelMural from './PanelMural.astro';

interface Props {
  datos: DatosMapa;
  artistas: Artista[];
  years: number[];
}

const { datos, artistas, years } = Astro.props;
const artistasConMurales = artistas.filter((a) => datos.puntos.some((p) => p.artistas.includes(a.slug)));
const clasesSelector =
  'cursor-pointer border-2 border-ink bg-paper px-3 py-2 font-hand text-xl text-ink shadow-[3px_3px_0_var(--ink)] transition-transform hover:-translate-y-0.5 focus-visible:-translate-y-0.5';
const clasesEtiqueta = 'text-xs font-medium tracking-widest text-muted-foreground uppercase';
---

<section data-mapa-murales aria-label="Mapa de murales">
  <div class="mb-6 flex flex-wrap items-end gap-x-6 gap-y-4">
    <label class="flex flex-col gap-1">
      <span class={clasesEtiqueta}>Año</span>
      <select data-filtro-year class={clasesSelector} aria-label="Filtrar murales por año">
        <option value="">todos los años</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
    </label>
    <label class="flex flex-col gap-1">
      <span class={clasesEtiqueta}>Artista</span>
      <select data-filtro-artista class={clasesSelector} aria-label="Filtrar murales por artista">
        <option value="">todos los artistas</option>
        {artistasConMurales.map((a) => <option value={a.slug}>{a.nombre}</option>)}
      </select>
    </label>
    <button
      type="button"
      data-limpiar
      hidden
      class="cursor-pointer font-hand text-xl text-terracotta underline decoration-wavy underline-offset-4 hover:text-ink"
    >
      quitar filtros ✕
    </button>
    <p data-contador aria-live="polite" class="ml-auto font-hand text-lg text-muted-foreground"></p>
  </div>
  <div
    class="mapa aspect-[4/5] max-h-[80vh] w-full border-2 border-ink sm:aspect-(--aspecto-ilustracion)"
    style={`--aspecto-ilustracion: ${datos.ancho} / ${datos.alto}`}
  >
  </div>
  <script type="application/json" set:html={JSON.stringify(datos)} />
  <PanelMural />
</section>

<script>
  import '../scripts/mapa-murales.ts';
</script>
