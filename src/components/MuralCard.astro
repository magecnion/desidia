---
import type { Artist, Mural } from '../domain/murals.ts';

interface Props {
  mural: Mural;
  artists: Artist[];
}

const { mural, artists } = Astro.props;
const names = mural.artists.map((slug) => artists.find((a) => a.slug === slug)?.name ?? slug);
const cover = mural.photos[0];
---

<article class="group">
  <a href={`/murales/${mural.slug}/`} class="block text-ink no-underline">
    <img
      src={cover.image}
      alt={cover.caption ?? mural.title}
      loading="lazy"
      width="400"
      height="267"
      class="aspect-[3/2] w-full rounded-lg border object-cover transition-transform duration-300 group-hover:-rotate-1"
    />
    <h3 class="mt-3 font-display text-2xl leading-tight group-hover:text-terracotta">{mural.title}</h3>
  </a>
  <p class="text-sm">
    <span class="font-hand text-xl text-terracotta">{mural.year}</span> · {names.join(', ')}
  </p>
  <p class="text-sm text-muted-foreground">{mural.address}</p>
</article>
