---
import type { Artista, Mural } from '../domain/murales.ts';
import TarjetaMural from './TarjetaMural.astro';

interface Props {
  murales: Mural[];
  artistas: Artista[];
}

const { murales, artistas } = Astro.props;
---

<ul class="grid list-none grid-cols-[repeat(auto-fill,minmax(16rem,1fr))] gap-x-6 gap-y-10 p-0" data-lista-murales>
  {
    murales.map((mural) => (
      <li data-slug={mural.slug}>
        <TarjetaMural mural={mural} artistas={artistas} />
      </li>
    ))
  }
</ul>
