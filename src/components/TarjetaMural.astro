---
import type { Artista, Mural } from '../domain/murales.ts';

interface Props {
  mural: Mural;
  artistas: Artista[];
}

const { mural, artistas } = Astro.props;
const nombres = mural.artistas.map((slug) => artistas.find((a) => a.slug === slug)?.nombre ?? slug);
const portada = mural.fotos[0];
---

<article class="tarjeta">
  <a href={`/murales/${mural.slug}/`}>
    <img src={portada.imagen} alt={portada.pie ?? mural.titulo} loading="lazy" width="400" height="267" />
    <h3>{mural.titulo}</h3>
  </a>
  <p>{mural.year} · {nombres.join(', ')}</p>
  <p class="direccion">{mural.direccion}</p>
</article>

<style>
  .tarjeta a {
    color: inherit;
    text-decoration: none;
  }
  .tarjeta img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
    width: 100%;
    border-radius: 4px;
  }
  h3 {
    margin: 0.5rem 0 0.25rem;
  }
  p {
    margin: 0;
  }
  .direccion {
    opacity: 0.7;
    font-size: 0.9em;
  }
</style>
