---
import type { Artista, Mural } from '../domain/murales.ts';

interface Props {
  mural: Mural;
  artistas: Artista[];
}

const { mural, artistas } = Astro.props;
const nombres = mural.artistas.map((slug) => artistas.find((a) => a.slug === slug)?.nombre ?? slug);
const portada = mural.fotos[0];
---

<article class="group">
  <a href={`/murales/${mural.slug}/`} class="block text-ink no-underline">
    <img
      src={portada.imagen}
      alt={portada.pie ?? mural.titulo}
      loading="lazy"
      width="400"
      height="267"
      class="aspect-[3/2] w-full rounded-lg border object-cover transition-transform duration-300 group-hover:-rotate-1"
    />
    <h3 class="mt-3 font-display text-2xl leading-tight group-hover:text-terracotta">{mural.titulo}</h3>
  </a>
  <p class="text-sm">
    <span class="font-hand text-xl text-terracotta">{mural.year}</span> · {nombres.join(', ')}
  </p>
  <p class="text-sm text-muted-foreground">{mural.direccion}</p>
</article>
