---
import type { Artist, Mural } from '../domain/murals.ts';
import MuralCard from './MuralCard.astro';

interface Props {
  murals: Mural[];
  artists: Artist[];
}

const { murals, artists } = Astro.props;
---

<ul class="grid list-none grid-cols-[repeat(auto-fill,minmax(16rem,1fr))] gap-x-6 gap-y-10 p-0" data-mural-list>
  {
    murals.map((mural) => (
      <li data-slug={mural.slug}>
        <MuralCard mural={mural} artists={artists} />
      </li>
    ))
  }
</ul>
