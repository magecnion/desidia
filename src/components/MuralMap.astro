---
import type { Artist } from '../domain/murals.ts';
import type { MapData } from '../map/client-data.ts';

interface Props {
  data: MapData;
  artists: Artist[];
  years: number[];
}

const { data, artists, years } = Astro.props;
const artistsWithMurals = artists.filter((a) => data.points.some((p) => p.artists.includes(a.slug)));
---

<section class="mural-map" data-mural-map aria-label="Mapa de murales">
  <div class="filters">
    <div class="years" role="group" aria-label="Filtrar por año">
      <button type="button" data-year-filter="">Todos</button>
      {years.map((year) => <button type="button" data-year-filter={year}>{year}</button>)}
    </div>
    <label>
      <span class="visually-hidden">Filtrar por artista</span>
      <select data-artist-filter>
        <option value="">Todos los artistas</option>
        {artistsWithMurals.map((a) => <option value={a.slug}>{a.name}</option>)}
      </select>
    </label>
    <span data-counter aria-live="polite"></span>
    <button type="button" data-clear hidden>Limpiar filtros</button>
  </div>
  <div class="map" style={`aspect-ratio: ${data.width} / ${data.height}`}></div>
  <script type="application/json" set:html={JSON.stringify(data)} />
</section>

<script>
  import '../scripts/mural-map.ts';
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  button,
  select {
    font: inherit;
    padding: 0.3rem 0.75rem;
    border: 1px solid #0003;
    border-radius: 999px;
    background: white;
    cursor: pointer;
  }
  button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }
  .map {
    width: 100%;
    max-height: 80vh;
    border-radius: 6px;
    background: #eee;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
