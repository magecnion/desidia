---
import Base from '../layouts/Base.astro';
import { getAjustes, getPagina } from '../data/repositorio.ts';

const { titulo, Content } = await getPagina('contacto');
const ajustes = getAjustes();
// Clave pública de Web3Forms (https://web3forms.com). Se configura como variable de entorno en Cloudflare Pages.
const claveFormulario = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<Base titulo={titulo}>
  <h1>{titulo}</h1>
  <Content />

  {
    claveFormulario ? (
      <form action="https://api.web3forms.com/submit" method="POST" class="formulario">
        <input type="hidden" name="access_key" value={claveFormulario} />
        <input type="hidden" name="subject" value="Nuevo mensaje desde la web de murales" />
        <input type="checkbox" name="botcheck" class="oculto" tabindex="-1" autocomplete="off" />
        <label>
          Nombre
          <input type="text" name="nombre" required autocomplete="name" />
        </label>
        <label>
          Email
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          Mensaje
          <textarea name="mensaje" rows="6" required />
        </label>
        <button type="submit">Enviar</button>
      </form>
    ) : (
      <p><em>Formulario pendiente de configurar (PUBLIC_WEB3FORMS_KEY).</em></p>
    )
  }

  {ajustes.email && <p><a href={`mailto:${ajustes.email}`}>{ajustes.email}</a></p>}
  {
    ajustes.redes.length > 0 && (
      <ul class="redes">
        {ajustes.redes.map((red) => (
          <li>
            <a href={red.url} rel="noopener">
              {red.nombre}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .formulario {
    display: grid;
    gap: 1rem;
    max-width: 32rem;
    margin: 2rem 0;
  }
  label {
    display: grid;
    gap: 0.25rem;
  }
  input,
  textarea,
  button {
    font: inherit;
    padding: 0.5rem;
  }
  .oculto {
    display: none;
  }
  .redes {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1rem;
  }
</style>
