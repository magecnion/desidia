---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---

<Base title="Página no encontrada">
  <p class="font-hand text-3xl text-terracotta">404</p>
  <h1 class="mb-6 font-display text-5xl leading-none sm:text-6xl">Esta pared está vacía</h1>
  <p class="rich-text mb-8">La página que buscas no existe o se ha movido.</p>
  <Button href="/" variant="ink" size="xl">Volver al mapa</Button>
</Base>
