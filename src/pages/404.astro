---
import Base from '../layouts/Base.astro';
import Boton from '../components/ui/Boton.astro';
---

<Base titulo="Página no encontrada">
  <p class="font-hand text-3xl text-terracotta">404</p>
  <h1 class="mb-6 font-display text-5xl leading-none sm:text-6xl">Esta pared está vacía</h1>
  <p class="prosa mb-8">La página que buscas no existe o se ha movido.</p>
  <Boton href="/" variante="tinta" tamano="xl">Volver al mapa</Boton>
</Base>
