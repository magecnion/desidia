---
import Base from '../layouts/Base.astro';
import ListaMurales from '../components/ListaMurales.astro';
import { getArtistas, getMurales } from '../data/repositorio.ts';

const [murales, artistas] = await Promise.all([getMurales(), getArtistas()]);
---

<Base>
  <h1>Murales de Argana Alta</h1>
  <section aria-label="Listado de murales">
    <h2>Listado</h2>
    <ListaMurales murales={murales} artistas={artistas} />
  </section>
</Base>
