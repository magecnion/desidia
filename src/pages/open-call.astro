---
import Base from '../layouts/Base.astro';
import { getPagina } from '../data/repositorio.ts';

const { titulo, Content } = await getPagina('open-call');
---

<Base titulo={titulo}>
  <h1 class="mb-8 font-display text-5xl leading-none sm:text-6xl">{titulo}</h1>
  <div class="prosa">
    <Content />
  </div>
</Base>
