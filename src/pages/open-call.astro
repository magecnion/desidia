---
import Base from '../layouts/Base.astro';
import { getPage } from '../data/repository.ts';

const { title, Content } = await getPage('open-call');
---

<Base title={title}>
  <h1 class="mb-8 font-display text-5xl leading-none sm:text-6xl">{title}</h1>
  <div class="rich-text">
    <Content />
  </div>
</Base>
