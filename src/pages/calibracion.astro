---
/**
 * Herramienta interna (no enlazada, noindex) para calibrar la ilustración:
 * muestra los puntos de control con su error y permite obtener el píxel de cualquier punto con un clic.
 */
import Base from '../layouts/Base.astro';
import { getArtistas, getMurales } from '../data/repositorio.ts';
import { ILUSTRACION, PROYECCION } from '../map/index.ts';
import { datosMapa } from '../map/datos-cliente.ts';
import { errorPorPunto } from '../map/proyeccion.ts';

const [murales, artistas] = await Promise.all([getMurales(), getArtistas()]);
const errores = errorPorPunto(ILUSTRACION);
const datos = {
  ...datosMapa(murales, artistas, ILUSTRACION, PROYECCION),
  puntosControl: ILUSTRACION.puntosControl.map((p, i) => ({ ...p, errorPx: errores[i].errorPx })),
};
const UMBRAL_ERROR_PX = 20;
---

<Base titulo="Calibración del mapa">
  <meta name="robots" content="noindex" slot="head" />
  <h1>Calibración del mapa</h1>
  <ol>
    <li>Haz clic en un lugar reconocible de la ilustración: se muestra su píxel y un fragmento listo para copiar.</li>
    <li>En Google Maps, clic derecho sobre ese mismo lugar → clic en las coordenadas para copiarlas.</li>
    <li>
      Añade el fragmento a <code>puntosControl</code> en <code>src/map/ilustracion.json</code> con el nombre y las coordenadas.
    </li>
  </ol>
  <p>
    <span class="leyenda punto-control"></span> punto de control · <span class="leyenda marcador"></span> mural
  </p>

  <div class="calibracion" data-calibracion>
    <div class="mapa" style={`aspect-ratio: ${datos.ancho} / ${datos.alto}`}></div>
    <script type="application/json" set:html={JSON.stringify(datos)} />
  </div>

  <h2>Error por punto de control</h2>
  <p>
    Distancia (en píxeles de la ilustración) entre donde está marcado cada punto y donde lo colocaría la
    transformación calculada sin él. Por encima de {UMBRAL_ERROR_PX} px conviene revisarlo. Los puntos del borde
    tienden a dar más error porque, al quitarlos, hay que extrapolar.
  </p>
  <table>
    <thead><tr><th>Punto</th><th>Píxel</th><th>Coordenadas</th><th>Error (px)</th></tr></thead>
    <tbody>
      {
        datos.puntosControl.map((p) => (
          <tr class={p.errorPx > UMBRAL_ERROR_PX ? 'alto' : undefined}>
            <td>{p.nombre}</td>
            <td>{p.pixel.join(', ')}</td>
            <td>{p.coordenadas}</td>
            <td>{Number.isNaN(p.errorPx) ? '—' : p.errorPx.toFixed(1)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>

<script>
  import L from 'leaflet';
  import { crearMapaIlustrado, iconoMural, latLngAPixel, pixelALatLng } from '../scripts/mapa-base.ts';
  import type { DatosMapa } from '../map/datos-cliente.ts';
  import type { PuntoControl } from '../map/proyeccion.ts';

  type Datos = DatosMapa & { puntosControl: (PuntoControl & { errorPx: number })[] };

  const raiz = document.querySelector<HTMLElement>('[data-calibracion]')!;
  const datos: Datos = JSON.parse(raiz.querySelector('script[type="application/json"]')!.textContent!);
  const mapa = crearMapaIlustrado(raiz.querySelector<HTMLElement>('.mapa')!, datos);

  for (const p of datos.puntosControl) {
    L.marker(pixelALatLng(p.pixel), {
      icon: L.divIcon({ className: 'marcador-control', iconSize: [14, 14], iconAnchor: [7, 7] }),
    })
      .bindTooltip(`${p.nombre}<br>error: ${Number.isNaN(p.errorPx) ? '—' : p.errorPx.toFixed(1)} px`)
      .addTo(mapa);
  }
  for (const p of datos.puntos) {
    L.marker(pixelALatLng(p.pixel), { icon: iconoMural() }).bindTooltip(p.titulo).addTo(mapa);
  }

  mapa.on('click', (evento) => {
    const [x, y] = latLngAPixel(evento.latlng);
    const fragmento = `{ "nombre": "", "pixel": [${x}, ${y}], "coordenadas": "" }`;
    const contenido = document.createElement('div');
    const codigo = Object.assign(document.createElement('code'), { textContent: fragmento });
    const boton = Object.assign(document.createElement('button'), { type: 'button', textContent: 'Copiar' });
    boton.addEventListener('click', async () => {
      await navigator.clipboard.writeText(fragmento);
      boton.textContent = 'Copiado';
    });
    contenido.append(`Píxel: ${x}, ${y}`, document.createElement('br'), codigo, document.createElement('br'), boton);
    L.popup().setLatLng(evento.latlng).setContent(contenido).openOn(mapa);
  });
</script>

<style>
  .mapa {
    width: 100%;
    max-height: 80vh;
    border-radius: 6px;
    cursor: crosshair;
  }
  table {
    border-collapse: collapse;
    width: 100%;
  }
  th,
  td {
    text-align: left;
    padding: 0.25rem 0.5rem;
    border-bottom: 1px solid #0001;
  }
  .alto {
    background: #fde2dc;
  }
  .leyenda {
    display: inline-block;
    width: 12px;
    height: 12px;
    vertical-align: middle;
  }
  .leyenda.punto-control,
  .calibracion :global(.marcador-control) {
    background: #1f6feb;
    border: 2px solid white;
    outline: 1px solid #1f6feb;
  }
  .leyenda.marcador {
    background: var(--color-acento);
    border-radius: 50%;
  }
</style>
