---
/**
 * Internal tool (not linked, noindex) to calibrate the illustration:
 * shows the control points with their error and lets you get the pixel of any point with a click.
 */
import Base from '../layouts/Base.astro';
import { getArtists, getMurals } from '../data/repository.ts';
import { ILLUSTRATION, PROJECTION } from '../map/index.ts';
import { mapData } from '../map/client-data.ts';
import { errorPerPoint } from '../map/projection.ts';

const [murals, artists] = await Promise.all([getMurals(), getArtists()]);
const errors = errorPerPoint(ILLUSTRATION);
const data = {
  ...mapData(murals, artists, ILLUSTRATION, PROJECTION),
  controlPoints: ILLUSTRATION.controlPoints.map((p, i) => ({ ...p, errorPx: errors[i].errorPx })),
};
const ERROR_THRESHOLD_PX = 20;
---

<Base title="Calibración del mapa">
  <meta name="robots" content="noindex" slot="head" />
  <h1 class="mb-6 font-display text-5xl leading-none">Calibración del mapa</h1>
  <ol class="rich-text mb-4 list-decimal pl-5">
    <li>Haz clic en un lugar reconocible de la ilustración: se muestra su píxel y un fragmento listo para copiar.</li>
    <li>En Google Maps, clic derecho sobre ese mismo lugar → clic en las coordenadas para copiarlas.</li>
    <li>
      Añade el fragmento a <code>controlPoints</code> en <code>src/map/illustration.json</code> con el nombre y las coordenadas.
    </li>
  </ol>
  <p class="mb-4 flex items-center gap-2 text-sm">
    <span class="inline-block size-3 border-2 border-card bg-cobalt outline outline-cobalt"></span> punto de control ·
    <span class="inline-block size-3 rounded-full bg-terracotta"></span> mural
  </p>

  <div data-calibration>
    <div
      class="map max-h-[80vh] min-h-[65vh] w-full sm:min-h-0 cursor-crosshair rounded-lg border"
      style={`aspect-ratio: ${data.width} / ${data.height}`}
    >
    </div>
    <script type="application/json" set:html={JSON.stringify(data)} />
  </div>

  <h2 class="mt-12 mb-3 font-display text-4xl">Error por punto de control</h2>
  <p class="rich-text mb-4">
    Distancia (en píxeles de la ilustración) entre donde está marcado cada punto y donde lo colocaría la
    transformación calculada sin él. Por encima de {ERROR_THRESHOLD_PX} px conviene revisarlo. Los puntos del borde
    tienden a dar más error porque, al quitarlos, hay que extrapolar.
  </p>
  <table class="w-full border-collapse text-left text-sm">
    <thead>
      <tr class="border-b text-muted-foreground">
        <th class="px-2 py-1 font-normal">Punto</th>
        <th class="px-2 py-1 font-normal">Píxel</th>
        <th class="px-2 py-1 font-normal">Coordenadas</th>
        <th class="px-2 py-1 font-normal">Error (px)</th>
      </tr>
    </thead>
    <tbody>
      {
        data.controlPoints.map((p) => (
          <tr class:list={['border-b', { 'bg-blush/40': p.errorPx > ERROR_THRESHOLD_PX }]}>
            <td class="px-2 py-1">{p.name}</td>
            <td class="px-2 py-1">{p.pixel.join(', ')}</td>
            <td class="px-2 py-1">{p.coordinates}</td>
            <td class="px-2 py-1">{Number.isNaN(p.errorPx) ? '—' : p.errorPx.toFixed(1)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>

<script>
  import L from 'leaflet';
  import { createIllustratedMap, pointIcon, latLngToPixel, pixelToLatLng } from '../scripts/base-map.ts';
  import type { MapData } from '../map/client-data.ts';
  import type { ControlPoint } from '../map/projection.ts';

  type Data = MapData & { controlPoints: (ControlPoint & { errorPx: number })[] };

  const root = document.querySelector<HTMLElement>('[data-calibration]')!;
  const data: Data = JSON.parse(root.querySelector('script[type="application/json"]')!.textContent!);
  const map = createIllustratedMap(root.querySelector<HTMLElement>('.map')!, data);

  for (const p of data.controlPoints) {
    L.marker(pixelToLatLng(p.pixel), {
      icon: L.divIcon({ className: 'control-marker', iconSize: [14, 14], iconAnchor: [7, 7] }),
    })
      .bindTooltip(`${p.name}<br>error: ${Number.isNaN(p.errorPx) ? '—' : p.errorPx.toFixed(1)} px`)
      .addTo(map);
  }
  for (const p of data.points) {
    L.marker(pixelToLatLng(p.pixel), { icon: pointIcon() }).bindTooltip(p.title).addTo(map);
  }

  map.on('click', (event) => {
    const [x, y] = latLngToPixel(event.latlng);
    const snippet = `{ "name": "", "pixel": [${x}, ${y}], "coordinates": "" }`;
    const content = document.createElement('div');
    const code = Object.assign(document.createElement('code'), { textContent: snippet });
    const button = Object.assign(document.createElement('button'), { type: 'button', textContent: 'Copiar' });
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(snippet);
      button.textContent = 'Copiado';
    });
    content.append(`Píxel: ${x}, ${y}`, document.createElement('br'), code, document.createElement('br'), button);
    L.popup().setLatLng(event.latlng).setContent(content).openOn(map);
  });
</script>

<style>
  [data-calibration] :global(.control-marker) {
    background: var(--cobalt);
    border: 2px solid var(--card);
    outline: 1px solid var(--cobalt);
  }
</style>
