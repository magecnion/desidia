---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ListaMurales from '../../components/ListaMurales.astro';
import { getArtistas, getMuralesDeArtista } from '../../data/repositorio.ts';
import { instagramUrl, type Artista } from '../../domain/murales.ts';
import { markdownAHtml } from '../../lib/markdown.ts';

export const getStaticPaths = (async () => {
  const artistas = await getArtistas();
  return artistas.map((artista) => ({ params: { slug: artista.slug }, props: { artista, artistas } }));
}) satisfies GetStaticPaths;

interface Props {
  artista: Artista;
  artistas: Artista[];
}

const { artista, artistas } = Astro.props;
const murales = await getMuralesDeArtista(artista.slug);
---

<Base titulo={artista.nombre}>
  <div class="grid gap-8 md:grid-cols-[20rem_1fr]">
    {
      artista.foto && (
        <img
          src={artista.foto}
          alt={artista.nombre}
          width="320"
          height="320"
          class="aspect-square w-full max-w-80 rounded-lg border object-cover"
        />
      )
    }
    <div class={artista.foto ? '' : 'md:col-span-2'}>
      <h1 class="mb-4 font-display text-5xl leading-none sm:text-6xl">{artista.nombre}</h1>
      {artista.bio && <div class="prosa" set:html={markdownAHtml(artista.bio)} />}
      {
        artista.instagram && (
          <p class="mt-4">
            <a href={instagramUrl(artista.instagram)} rel="noopener" class="text-terracotta">
              @{artista.instagram}
            </a>
          </p>
        )
      }
    </div>
  </div>

  <section class="mt-16">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="font-display text-4xl">Murales <span class="font-hand text-3xl text-terracotta">({murales.length})</span></h2>
      <a href={`/?artista=${artista.slug}`} class="text-terracotta underline-offset-4 hover:underline">Ver en el mapa →</a>
    </div>
    <ListaMurales murales={murales} artistas={artistas} />
  </section>
</Base>
