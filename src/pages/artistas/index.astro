---
import Base from '../../layouts/Base.astro';
import { getArtistas, getMurales } from '../../data/repositorio.ts';
import { muralesDeArtista } from '../../domain/murales.ts';

const [artistas, murales] = await Promise.all([getArtistas(), getMurales()]);
---

<Base titulo="Artistas">
  <h1 class="mb-8 font-display text-5xl leading-none sm:text-6xl">Artistas</h1>
  <ul class="grid list-none gap-x-8 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {
      artistas.map((artista) => {
        const total = muralesDeArtista(murales, artista.slug).length;
        return (
          <li class="border-b py-3">
            <a href={`/artistas/${artista.slug}/`} class="group flex items-baseline justify-between gap-4 text-ink no-underline">
              <span class="font-display text-2xl group-hover:text-terracotta">{artista.nombre}</span>
              <span class="font-hand text-xl text-terracotta">{total === 1 ? '1 mural' : `${total} murales`}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>
