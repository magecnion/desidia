---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { getArtistas, getMurales } from '../../data/repositorio.ts';
import { googleMapsUrl, type Artista, type Mural } from '../../domain/murales.ts';
import { markdownAHtml } from '../../lib/markdown.ts';

export const getStaticPaths = (async () => {
  const [murales, artistas] = await Promise.all([getMurales(), getArtistas()]);
  return murales.map((mural) => ({ params: { slug: mural.slug }, props: { mural, artistas } }));
}) satisfies GetStaticPaths;

interface Props {
  mural: Mural;
  artistas: Artista[];
}

const { mural, artistas } = Astro.props;
const artistasMural = mural.artistas
  .map((slug) => artistas.find((a) => a.slug === slug))
  .filter((a): a is Artista => a !== undefined);
---

<Base titulo={mural.titulo}>
  <p class="font-hand text-3xl text-terracotta">{mural.year}</p>
  <h1 class="mb-6 font-display text-5xl leading-none sm:text-6xl">{mural.titulo}</h1>

  <dl class="mb-8 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
    <dt class="text-muted-foreground">{artistasMural.length > 1 ? 'Artistas' : 'Artista'}</dt>
    <dd>
      {
        artistasMural.map((artista, i) => (
          <>
            {i > 0 && ', '}
            <a href={`/artistas/${artista.slug}/`} class="text-terracotta">
              {artista.nombre}
            </a>
          </>
        ))
      }
    </dd>
    <dt class="text-muted-foreground">Dirección</dt>
    <dd>
      {mural.direccion}
      <a href={googleMapsUrl(mural.coordenadas)} rel="noopener" class="ml-2 whitespace-nowrap text-terracotta">
        Abrir en Google Maps ↗
      </a>
    </dd>
  </dl>

  {mural.descripcion && <div class="prosa mb-10" set:html={markdownAHtml(mural.descripcion)} />}

  <section class="grid gap-8" aria-label="Fotos">
    {
      mural.fotos.map((foto) => (
        <figure>
          <img
            src={foto.imagen}
            alt={foto.pie ?? mural.titulo}
            loading="lazy"
            width="1200"
            height="800"
            class="w-full rounded-lg border"
          />
          {(foto.pie || foto.credito) && (
            <figcaption class="mt-2 text-sm text-muted-foreground">
              {foto.pie}
              {foto.pie && foto.credito && ' · '}
              {foto.credito}
            </figcaption>
          )}
        </figure>
      ))
    }
  </section>
</Base>
