---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { getArtists, getMurals } from '../../data/repository.ts';
import { googleMapsUrl, type Artist, type Mural } from '../../domain/murals.ts';
import { markdownToHtml } from '../../lib/markdown.ts';

export const getStaticPaths = (async () => {
  const [murals, artists] = await Promise.all([getMurals(), getArtists()]);
  return murals.map((mural) => ({ params: { slug: mural.slug }, props: { mural, artists } }));
}) satisfies GetStaticPaths;

interface Props {
  mural: Mural;
  artists: Artist[];
}

const { mural, artists } = Astro.props;
const muralArtists = mural.artists
  .map((slug) => artists.find((a) => a.slug === slug))
  .filter((a): a is Artist => a !== undefined);
---

<Base title={mural.title}>
  <p class="font-hand text-3xl text-terracotta">{mural.year}</p>
  <h1 class="mb-6 font-display text-5xl leading-none sm:text-6xl">{mural.title}</h1>

  <dl class="mb-8 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2">
    <dt class="text-muted-foreground">{muralArtists.length > 1 ? 'Artistas' : 'Artista'}</dt>
    <dd>
      {
        muralArtists.map((artist, i) => (
          <>
            {i > 0 && ', '}
            <a href={`/artistas/${artist.slug}/`} class="text-terracotta">
              {artist.name}
            </a>
          </>
        ))
      }
    </dd>
    <dt class="text-muted-foreground">Dirección</dt>
    <dd>
      {mural.address}
      <a href={googleMapsUrl(mural.coordinates)} rel="noopener" class="ml-2 whitespace-nowrap text-terracotta">
        Abrir en Google Maps ↗
      </a>
    </dd>
  </dl>

  {mural.description && <div class="rich-text mb-10" set:html={markdownToHtml(mural.description)} />}

  <section class="grid gap-8" aria-label="Fotos">
    {
      mural.photos.map((photo) => (
        <figure>
          <img
            src={photo.image}
            alt={photo.caption ?? mural.title}
            loading="lazy"
            width="1200"
            height="800"
            class="w-full rounded-lg border"
          />
          {(photo.caption || photo.credit) && (
            <figcaption class="mt-2 text-sm text-muted-foreground">
              {photo.caption}
              {photo.caption && photo.credit && ' · '}
              {photo.credit}
            </figcaption>
          )}
        </figure>
      ))
    }
  </section>
</Base>
