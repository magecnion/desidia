---
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = 'Murales de Argana Alta, Arrecife (Lanzarote)' } = Astro.props;
const nombreSitio = 'Desidia';
const tituloCompleto = titulo ? `${titulo} · ${nombreSitio}` : nombreSitio;

const enlaces = [
  { href: '/', texto: 'Mapa' },
  { href: '/artistas/', texto: 'Artistas' },
  { href: '/open-call/', texto: 'Open call' },
  { href: '/contacto/', texto: 'Contacto' },
];
const rutaActual = Astro.url.pathname;
const esActual = (href: string) => (href === '/' ? rutaActual === '/' : rutaActual.startsWith(href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <header class="border-b">
      <div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-4 py-5">
        <a href="/" class="font-display text-3xl leading-none text-ink no-underline">{nombreSitio}</a>
        <nav class="flex flex-wrap gap-x-6 gap-y-1">
          {
            enlaces.map(({ href, texto }) => (
              <a
                href={href}
                aria-current={esActual(href) ? 'page' : undefined}
                class="text-ink underline-offset-8 decoration-terracotta decoration-2 hover:text-terracotta aria-[current=page]:underline"
              >
                {texto}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 pt-8 pb-20">
      <slot />
    </main>
  </body>
</html>
