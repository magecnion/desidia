---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Murales de Argana Alta, Arrecife (Lanzarote)' } = Astro.props;
const siteName = 'Desidia';
const fullTitle = title ? `${title} · ${siteName}` : siteName;

const links = [
  { href: '/', text: 'Mapa' },
  { href: '/artistas/', text: 'Artistas' },
  { href: '/open-call/', text: 'Open call' },
  { href: '/contacto/', text: 'Contacto' },
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <header class="border-b">
      <div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-4 py-5">
        <a href="/" class="font-display text-3xl leading-none text-ink no-underline">{siteName}</a>
        <nav class="flex flex-wrap gap-x-6 gap-y-1">
          {
            links.map(({ href, text }) => (
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="text-ink underline-offset-8 decoration-terracotta decoration-2 hover:text-terracotta aria-[current=page]:underline"
              >
                {text}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 pt-8 pb-20">
      <slot />
    </main>
  </body>
</html>
