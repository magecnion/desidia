// Despliegue en Cloudflare Workers como sitio estático (sin código de servidor). Ver docs/despliegue.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "desidia",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // URL de preview por rama (p. ej. poc-plan-desidia.<subdominio>.workers.dev)
  "preview_urls": true
}
